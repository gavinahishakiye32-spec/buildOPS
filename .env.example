# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# Every key below is read by src/app.module.ts, src/auth, src/mail, or src/bootstrap.ts.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated list of browser origins allowed to call this API.
# Leave unset in development to allow the common local dev servers.
# Required in production (unset = all cross-origin requests rejected).
# ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=ops

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=3600

# ─── Rate limiting (values in ms) ───────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_TTL=900000
AUTH_THROTTLE_LIMIT=10

# ─── Email ──────────────────────────────────────────────────────────────────
# Verification/reset links are printed to the server console in development,
# so no mail provider is required to run locally.
# Leave RESEND_API_KEY empty to use SMTP instead.
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=