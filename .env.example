# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# Every key below is read by src/main.ts, src/bootstrap.ts, src/app.module.ts,
# src/swagger.setup.ts, src/auth or src/mail.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated list of browser origins allowed to call this API.
# Unset (the default) permits any origin, so the frontend can be hosted
# anywhere without touching this file. Set it only to lock things down.
# ALLOWED_ORIGINS=https://app.example.com
# Required when NODE_ENV=production. '*' is rejected in production: the refresh
# token is a cookie, so an open allow-list would let any origin make credentialed
# calls. See docs/frontend-guide.md section 2.

# Absolute lifetime of a refresh-token session, in days. NOT sliding: a session
# ends this long after it was created however often it is refreshed, so a token
# that leaked once cannot be kept alive by its holder. Default 30.
# REFRESH_TOKEN_TTL_DAYS=30

# How often to delete refresh tokens that can no longer do anything (expired, or
# revoked long enough ago that they can no longer catch a replay). Default 6.
# SESSION_CLEANUP_INTERVAL_HOURS=6

# How long a soft-deleted record stays recoverable before it is permanently
# removed. Long enough for a mistake to be noticed and reported; short enough
# that the tables are not an archive. Set to 0 to keep deleted records forever.
# SOFT_DELETE_RETENTION_DAYS=30

# How often that purge runs. Default 24.
# PURGE_INTERVAL_HOURS=24

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=ops

# ─── Auth ───────────────────────────────────────────────────────────────────
# REQUIRED in production: the app refuses to boot when NODE_ENV=production and
# this is empty, because a shipped fallback secret would let anyone forge a
# token. It signs every credential the API issues -- access, refresh, email
# verification, password reset and invitation -- so a leak here compromises all
# of them at once, not just the access token. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=3600

# ─── Rate limiting (values in ms) ───────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_TTL=900000
AUTH_THROTTLE_LIMIT=10

# ─── Billing ────────────────────────────────────────────────────────────────
# Which BillingProvider implementation collects payment.
#
#   stripe  real payments through Stripe Checkout; requires the two keys below
#   stub    development only: settles every purchase instantly and charges
#           nothing, so POST /subscription would grant the Business plan for
#           free. It refuses to start when NODE_ENV=production, and production
#           refuses to start without an explicit BILLING_PROVIDER, so the
#           free-plan failure mode is a boot error rather than a live bug.
#
# Unset means `stub` outside production and a boot error inside it.
BILLING_PROVIDER=stripe

# Secret key of the Stripe account that takes the money (Developers > API
# keys). Required whenever BILLING_PROVIDER=stripe.
STRIPE_SECRET_KEY=

# Signing secret of the webhook endpoint that confirms a payment, created at
# Dashboard > Developers > Webhooks with the URL:
#   https://<your-api-host>/api/v1/billing/webhook
# and selecting at least checkout.session.completed and
# checkout.session.async_payment_succeeded. Required whenever
# BILLING_PROVIDER=stripe: without it a payment can be taken but never applied.
STRIPE_WEBHOOK_SECRET=

# Currency the plan catalogue is priced in when a Stripe price is provisioned
# for a plan (ISO 4217, lower case).
STRIPE_CURRENCY=usd

# Length of the free trial granted on first subscription, in days. Read per
# subscription rather than baked into the code, so it can be changed without a
# deploy -- but changing it does not retroactively alter a trial already running.
TRIAL_DAYS=14

# ─── Email ──────────────────────────────────────────────────────────────────
# Public origin of the app that the verification/reset links in outgoing email
# should point at. Default is the API host itself, which resolves but shows raw
# JSON -- point it at the frontend origin to make the links open a real page.
APP_BASE_URL=http://localhost:3000

# Sender address. Must be accepted by the SMTP server below: Gmail, for
# instance, only relays mail whose From: is the authenticated account or one of
# its aliases.
EMAIL_FROM=no-reply@example.com

# Outgoing mail goes through SMTP (nodemailer) -- there is no Resend/HTTP
# provider. A failed send is logged by MailService and does not fail the
# request that triggered it, so an unreachable SMTP server leaves you without
# the verification/reset link: check the API log for the
# `[MailService] Failed to send email` line.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# ─── Notification email delivery ────────────────────────────────────────────
# Notification emails (assignment, reassignment, milestones) are not sent from
# inside the request that triggers them. They are written to a durable outbox in
# the same transaction as the in-app notification, and a background worker
# delivers them, retrying with an exponential backoff. A brief SMTP outage
# therefore delays an email instead of silently losing it, and every outcome is
# a row in `notification_emails` rather than a line in a log.
#
# How often the worker polls for due emails, in ms. Set to 0 to disable the
# worker entirely (the e2e suite does, then drives delivery by hand).
# NOTIFICATION_EMAIL_INTERVAL_MS=15000
# How many due emails one pass may claim at once.
# NOTIFICATION_EMAIL_BATCH_SIZE=50
# Attempts per email before it is marked `failed` and given up on.
# NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
# Backoff base and ceiling, in ms: the Nth retry waits base * 2^(N-1), capped at
# the ceiling, so a real outage widens out instead of being hammered each poll.
# NOTIFICATION_EMAIL_RETRY_BASE_MS=60000
# NOTIFICATION_EMAIL_RETRY_MAX_MS=3600000
# How long a claimed email is leased before another pass may pick it up again,
# so a worker that dies mid-send does not strand the row.
# NOTIFICATION_EMAIL_LEASE_MS=120000

# Outside production (NODE_ENV unset or anything but `production`) the API does
# not depend on any of the above: POST /auth/register, POST /auth/forgot-password
# and the 403 of an unverified login also return the raw token and link in the
# JSON body (`verificationToken`/`verificationLink`, `resetToken`/`resetLink`),
# together with `emailSent`/`emailError` reporting what SMTP actually did. A
# production response never contains a token -- there it exists only in the
# email, which is why it is stored hashed.
